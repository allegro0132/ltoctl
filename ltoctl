run_restore() {
    # Define the specific log file for this restore run
    CURRENT_LOG_FILE="${LOG_FILE_BASE}_$(date +%Y%m%d_%H%M%S).log"
    local FS_COUNT="$1"
    local DEST_DIR="$2"
    local RESTORE_NUM="$3"
    local FILE_POINTER=$FS_COUNT

    if [[ -z "$RESTORE_NUM" ]]; then
        RESTORE_NUM=-1
    fi

    # 1. Parameter Validation
    if [[ ! "$FS_COUNT" =~ ^[0-9]+$ ]]; then
        log_message "Warning: restore command requires a valid archive number (starting from 0), set defaulting to 0."
        FS_COUNT=0
        FILE_POINTER=0
    fi

    # 2. Check or create destination directory
    if [[ -n "$DEST_DIR" ]]; then
        if [ ! -d "$DEST_DIR" ]; then
            log_message "WARNING: Destination directory $DEST_DIR does not exist. Attempting to create..."
            if ! sudo mkdir -p "$DEST_DIR"; then
                log_message "CRITICAL ERROR: Cannot create destination directory $DEST_DIR. Aborting restore."
                return 1
            fi
        fi
    else
        # Default restore to current directory
        DEST_DIR="."
    fi

    log_message "--- Starting Restore Process ---"
    log_message "Start Archive Index: #$FILE_POINTER"
    log_message "Target Directory: $DEST_DIR"
    log_message "--------------------"

    # 3. Tape Positioning
    log_message "1. Rewinding tape to Beginning of Tape (BOT)."
    if ! tape_command "rewind"; then
        log_message "ERROR: Rewind failed. Aborting."
        return 1
    fi

    if [ "$FS_COUNT" -gt 0 ]; then
        log_message "2. Skipping $FS_COUNT file marks to position at Archive #$FILE_POINTER."
        if ! tape_command "fsf" "$FS_COUNT"; then
            log_message "ERROR: Failed to position tape. Aborting."
            return 1
        fi
    else
        log_message "2. Restoring from Archive #0."
    fi

    # 4. Restore Operation
    # Using -b 2048 (1MB block size) to match the write blocking factor.
    log_message "3. Executing restore command: tar -xvf $TAPE_DEVICE -b $BLOCK_SIZE -C $DEST_DIR"

    while [ "$RESTORE_NUM" -ne 0 ]; do
        log_message "Restoring Archive #$FILE_POINTER ..."
        # Perform the restore
        if tar -xvf "$TAPE_DEVICE" -b "$BLOCK_SIZE" -C "$DEST_DIR" 2>&1 >> "$CURRENT_LOG_FILE"; then
            log_message "SUCCESS: Archive $FILE_POINTER successfully restored to $DEST_DIR"
            # Skip end EOF marker for next operation
            if tape_command "fsf" "1"; then
                log_message "Note: The tape head is now positioned after the restored archive."
            else
                log_message "ERROR: Failed to skip EOF marker after restore. Exit Status: $?."
                break
            fi
        else
            log_message "ERROR: tar failed during restoration. Exit Status: $?. Please check the log file."
            break
        fi
        RESTORE_NUM=$((RESTORE_NUM - 1))
        FILE_POINTER=$((FILE_POINTER + 1))
    done

    log_message "--- Restore Process Finished ---"
}

# --- Main Script Execution ---

# Check if a subcommand was provided
if [ $# -eq 0 ]; then
    echo "Usage: $0 <command> [argument]"
    echo ""
    echo "Tape Management Commands (alias: $TAPE_DEVICE):"
    echo "  status            - Check tape drive status."
    echo "  rewind            - Rewind the tape to the start."
    echo "  eject | rewoffl   - Rewind and eject the tape."
    echo "  eof [N]           - Write N End-of-File marks (default: 1)."
    echo "  fsf [N]           - Forward space N file marks (default: 1)."
    echo "  bsf [N]           - Backward space N file marks (default: 1)."
    echo ""
    echo "Backup Command:"
    echo "  backup [BACKUP_SOURCE_DIR]            - Run the full folder/file backup process."
    echo ""
    echo "Restore Command:"
    echo "  restore [START_INDEX] [DEST_PATH] [NUM_ARCHIVES] - Restore a specific archive by 0-based index."
    exit 1
fi

SUBCOMMAND=$1
ARGUMENT=$2
BACKUP_ARGUMENT=$3
RESTORE_NUM_ARG=$4

case "$SUBCOMMAND" in
    status|rewind|eject|rewoffl|eof|fsf|bsf)
        # Handle simple mt commands
        if [[ "$SUBCOMMAND" == "eject" ]]; then
            SUBCOMMAND="rewoffl" # Map eject to rewoffl
        fi

        # Check if an argument (N) is required for commands like fsf/bsf/eof
        if [[ "$SUBCOMMAND" == "fsf" || "$SUBCOMMAND" == "bsf" || "$SUBCOMMAND" == "eof" ]]; then
            # Default N to 1 if no argument is provided
            if [[ -z "$ARGUMENT" ]]; then
                ARGUMENT="1"
            fi
        fi

        tape_command "$SUBCOMMAND" "$ARGUMENT"
        ;;

    backup)
        # Run the full backup function
        run_backup "$ARGUMENT" "$BACKUP_ARGUMENT"
        ;;

    restore)
        # Run the restore function
        run_restore "$ARGUMENT" "$BACKUP_ARGUMENT" "$RESTORE_NUM_ARG"
        ;;

    *)
        log_message "ERROR: Unknown command '$SUBCOMMAND'. Run script without arguments for usage."
        exit 1
        ;;
esac