# --- Main Script Execution ---

# Check if a subcommand was provided
if [ $# -eq 0 ]; then
    echo "Usage: $0 <command> [argument]"
    echo ""
    echo "Tape Management Commands (alias: $TAPE_DEVICE):"
    echo "  status            - Check tape drive status."
    echo "  rewind            - Rewind the tape to the start."
    echo "  eject | rewoffl   - Rewind and eject the tape."
    echo "  eof [N]           - Write N End-of-File marks (default: 1)."
    echo "  fsf [N]           - Forward space N file marks (default: 1)."
    echo "  bsf [N]           - Backward space N file marks (default: 1)."
    echo ""
    echo "Backup Command:"
    echo "  backup [BACKUP_SOURCE_DIR]            - Run the full folder/file backup process."
    exit 1
fi

SUBCOMMAND=$1
ARGUMENT=$2
BACKUP_ARGUMENT=$3

case "$SUBCOMMAND" in
    status|rewind|eject|rewoffl|eof|fsf|bsf)
        # Handle simple mt commands
        if [[ "$SUBCOMMAND" == "eject" ]]; then
            SUBCOMMAND="rewoffl" # Map eject to rewoffl
        fi

        # Check if an argument (N) is required for commands like fsf/bsf/eof
        if [[ "$SUBCOMMAND" == "fsf" || "$SUBCOMMAND" == "bsf" || "$SUBCOMMAND" == "eof" ]]; then
            # Default N to 1 if no argument is provided
            if [[ -z "$ARGUMENT" ]]; then
                ARGUMENT="1"
            fi
        fi

        tape_command "$SUBCOMMAND" "$ARGUMENT"
        ;;

    backup)
        # Run the full backup function
        run_backup "$ARGUMENT" "$BACKUP_ARGUMENT"
        ;;

    *)
        log_message "ERROR: Unknown command '$SUBCOMMAND'. Run script without arguments for usage."
        exit 1
        ;;
esac