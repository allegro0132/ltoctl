            if [ "$ITEM_NAME" == "$START_ARCHIVE" ]; then
                SHOULD_BACKUP="true"
                log_message "CHECKPOINT REACHED: Found $ITEM_NAME. Starting backups now."
            else
                log_message "SKIP: Skipping $ITEM_NAME..."
                continue
            fi
        fi

