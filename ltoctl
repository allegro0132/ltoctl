        if tar -cvf "$TAPE_DEVICE" -b "$BLOCK_SIZE" -C "$BACKUP_SOURCE" "$ITEM_NAME" 2>&1 >> "$CURRENT_LOG_FILE"; then
            log_message "SUCCESS: Backed up $ITEM_NAME."
            ARCHIVE_COUNT=$((ARCHIVE_COUNT + 1))
            # Write EOF check
            #if ! mt -f "$TAPE_DEVICE" eof; then
            #    log_message "CRITICAL WARNING: EOF marker failed. Likely End of Media (EOM). Halting backups."
