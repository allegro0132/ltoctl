#!/bin/bash

# --- Configuration Parameters ---
# **IMPORTANT: Configure your environment here**
TAPE_DEVICE="/dev/nst0"                         # Your LTO-6 tape drive device name (Non-Rewinding)
LOG_FILE_BASE="/var/log/lto_backup"            # Base path for log files
BLOCK_SIZE="1024"
# --- Script Variables ---
ARCHIVE_COUNT=0
# Function to write messages to the log file and console (for backup operations)
log_message() {
    # If the log file is not yet defined (i.e., not a backup run), use console only
    if [[ -z "$CURRENT_LOG_FILE" ]]; then
        echo "$(date '+%Y-%m-%d %H:%M:%S') - $1"
    else
        echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "$CURRENT_LOG_FILE"
        echo "$(date '+%Y-%m-%d %H:%M:%S') - $1"
    fi
}

# --- Tape Management Functions ---

# Function to execute mt commands
tape_command() {
    local cmd="$1"
    local arg="$2"
    log_message "Executing mt command: mt -f $TAPE_DEVICE $cmd $arg"

    # Check if device is configured before running mt
    if [ ! -c "$TAPE_DEVICE" ]; then
        log_message "ERROR: Tape device $TAPE_DEVICE is not accessible or not configured. Cannot execute $cmd."
        return 1
    fi

    if [[ -z "$arg" ]]; then
        mt -f "$TAPE_DEVICE" "$cmd"
    else
        mt -f "$TAPE_DEVICE" "$cmd" "$arg"
    fi

    if [ $? -eq 0 ]; then
        log_message "Successfully executed $cmd."
        return 0
    else
        log_message "ERROR: Failed to execute $cmd. Check device status and log."
        return 1
    fi
}

